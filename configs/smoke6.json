{
  "run": "smoke6",
  "note": "tiny end-to-end smoke of the run6 stack: auxiliary final-wall heads, playout-cap randomization, 8 determinizations per refill, on top of run5's batched self-play",
  "seed": 13,
  "device": "cpu",
  "_note_engine": "workers 2 x selfplay_games 4 = 8 concurrent trees over 2 driver processes, on CPU so the test needs no GPU. search_batch 2 with a ramp of 4 exercises the within-tree virtual-loss path as well, which the run config leaves off.",
  "selfplay": "batched",
  "selfplay_games": 4,
  "selfplay_device": "cpu",
  "selfplay_max_batch": 0,
  "search_batch": 2,
  "search_batch_ramp": 4,
  "search_min_batch": 1,
  "virtual_loss": 1.0,
  "workers": 2,
  "arch": "structured",
  "margin_head": true,
  "aux_heads": true,
  "embed": 32,
  "layers": 2,
  "heads": 4,
  "ffn_mult": 2,
  "body": 64,
  "body_blocks": 1,
  "value_hidden": 32,
  "policy_rank": 8,
  "_note_pcr": "full_prob 0.5 rather than run6's 0.25 so a 24-game smoke reliably contains both kinds of move (at 0.25 and ~50 moves a game it would too, but 0.5 makes the assertion on both masks cheap and certain). sims must equal full_sims.",
  "sims": 16,
  "pcr": {
    "full_sims": 16,
    "cheap_sims": 4,
    "full_prob": 0.5
  },
  "tree_reuse": true,
  "c_puct": 1.4,
  "dirichlet_alpha_scale": 10.0,
  "dirichlet_eps": 0.25,
  "chance_children": 8,
  "chance_backup": "mean",
  "temp_moves": 6,
  "temperature": 1.0,
  "stall_rounds": 7,
  "max_game_moves": 400,
  "value_score_weight": 0.0,
  "decisive_eps": 0.03,
  "decisive_min_visit_frac": 0.1,
  "margin_weight": 0.25,
  "aux_weight": 0.1,
  "pretrain_epochs": 1,
  "pretrain_lr": 0.001,
  "pretrain_keep_buffer": true,
  "pretrain_unblend": 0.0,
  "games_per_iter": 8,
  "total_games": 24,
  "min_buffer": 64,
  "batch_size": 32,
  "steps_per_position": 1.0,
  "chunk_steps": 10,
  "lr": 0.001,
  "lr_min": 0.0005,
  "lr_schedule": "cosine",
  "lr_total_steps": 500,
  "weight_decay": 0.0001,
  "value_weight": 1.0,
  "grad_clip": 1.0,
  "replay_capacity": 20000,
  "save_buffer": true,
  "eval_every_games": 8,
  "eval_games": 4,
  "eval_sims": 8,
  "eval_workers": 2,
  "eval_anchors": [
    "random",
    "greedy"
  ],
  "eval_frozen": 1,
  "anchor_elos": {
    "random": 0.0
  },
  "eval_at_start": true,
  "heartbeat": 5.0
}