{
  "run": "smoke3",
  "note": "tiny end-to-end smoke of the run3 stack: structured net, tree reuse, optional --pretrain",
  "seed": 7,
  "device": "cpu",
  "workers": 2,
  "arch": "structured",
  "embed": 32,
  "layers": 1,
  "heads": 2,
  "ffn_mult": 2,
  "body": 64,
  "body_blocks": 1,
  "value_hidden": 32,
  "policy_rank": 8,
  "policy_global": true,
  "sims": 16,
  "tree_reuse": true,
  "c_puct": 1.4,
  "dirichlet_alpha_scale": 10.0,
  "dirichlet_eps": 0.25,
  "chance_children": 2,
  "temp_moves": 6,
  "temperature": 1.0,
  "stall_rounds": 7,
  "max_game_moves": 400,
  "value_score_weight": 0.15,
  "pretrain_epochs": 1,
  "pretrain_lr": 0.001,
  "pretrain_keep_buffer": true,
  "games_per_iter": 8,
  "total_games": 24,
  "min_buffer": 64,
  "batch_size": 32,
  "steps_per_position": 1.0,
  "chunk_steps": 10,
  "lr": 0.001,
  "lr_min": 0.0005,
  "lr_schedule": "cosine",
  "lr_total_steps": 500,
  "weight_decay": 0.0001,
  "value_weight": 1.0,
  "grad_clip": 1.0,
  "replay_capacity": 20000,
  "save_buffer": true,
  "eval_every_games": 8,
  "eval_games": 4,
  "eval_sims": 8,
  "eval_workers": 2,
  "eval_anchors": [
    "random",
    "greedy"
  ],
  "eval_frozen": 1,
  "anchor_elos": {
    "random": 0.0
  },
  "eval_at_start": true,
  "heartbeat": 5.0
}